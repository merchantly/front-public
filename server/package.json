{
  "name": "ssr-server",
  "version": "1.0.0",
  "description": "Bun SSR Server for React components",
  "type": "module",
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch index.ts",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "bun-types": "^1.1.0",
    "typescript": "^5.4.0"
  }
}
